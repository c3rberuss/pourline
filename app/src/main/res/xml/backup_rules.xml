<?xml version="1.0" encoding="utf-8"?>
<!--
   Copia automática de Android (SPEC-011 §3.6), API 26 a 30: no distingue entre la nube y el cambio de teléfono, así que
   lleva la base y los ajustes, sin las fotos (`coffee_photos/` es COFFEE_PHOTOS_DIR; pueden superar la cuota de 25 MB).
-->
<full-backup-content>
    <include domain="database" path="history.db" />
    <include domain="database" path="history.db-wal" />
    <include domain="database" path="history.db-shm" />
    <include domain="sharedpref" path="settings.xml" />
</full-backup-content>
